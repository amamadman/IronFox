From 2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d Mon Sep 17 00:00:00 2001
From: amamadman <falixum@gmail.com>
Date: Sat, 02 May 2026 00:00:00 +0000
Subject: [PATCH] fix: Simplify address bar back navigation

Removes the actionGlobalHome() navigation before SearchDialog in
handleToolbarClick() so BrowserFragment stays in the back stack.
Simplifies dismissDialogAndGoBack() to just dismiss the dialog.
BrowserFragment is revealed underneath, restoring the correct tab
without the null session ID issue.

---
 .../toolbar/BrowserToolbarController.kt           | 23 +------------------
 .../search/SearchDialogFragment.kt               | 12 ---------
 2 files changed, 2 insertions(+), 33 deletions(-)

diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarController.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarController.kt
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarController.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarController.kt
@@ -143,28 +143,12 @@
 
     override fun handleToolbarClick() {
-        Events.searchBarTapped.record(Events.SearchBarTappedExtra("BROWSER"))
-        // If we're displaying awesomebar search results, Home screen will not be visible (it's
-        // covered up with the search results). So, skip the navigation event in that case.
-        // If we don't, there's a visual flickr as we navigate to Home and then display search
-        // results on top it.
-        if (currentSession?.content?.searchTerms.isNullOrBlank()) {
-            navController.navigate(
-                BrowserFragmentDirections.actionGlobalHome(),
-            )
-            navController.navigate(
-                BrowserFragmentDirections.actionGlobalSearchDialog(
-                    currentSession?.id,
-                ),
-                ToolbarNavOptionsHelper.getToolbarNavOptions(activity),
-            )
-        } else {
-            navController.navigate(
-                BrowserFragmentDirections.actionGlobalSearchDialog(
-                    currentSession?.id,
-                ),
-                ToolbarNavOptionsHelper.getToolbarNavOptions(activity),
-            )
-        }
+        Events.searchBarTapped.record(Events.SearchBarTappedExtra("BROWSER"))
+        navController.navigate(
+            BrowserFragmentDirections.actionGlobalSearchDialog(
+                currentSession?.id,
+            ),
+            ToolbarNavOptionsHelper.getToolbarNavOptions(activity),
+        )
     }
 
     override fun handleTabCounterClick() {

diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/SearchDialogFragment.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/SearchDialogFragment.kt
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/SearchDialogFragment.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/SearchDialogFragment.kt
@@ -698,18 +698,6 @@
     private fun dismissDialogAndGoBack() {
         runIfFragmentIsAttached {
-            // In case we're displaying search results, we wouldn't have navigated to home, and
-            // so we don't need to navigate "back to" browser fragment.
-            // See mirror of this logic in BrowserToolbarController#handleToolbarClick.
-            if (store.state.searchTerms.isBlank()) {
-                val args by navArgs<SearchDialogFragmentArgs>()
-                args.sessionId?.let {
-                    findNavController().navigate(
-                        SearchDialogFragmentDirections.actionGlobalBrowser(null),
-                    )
-                }
-            }
-
             view?.hideKeyboard()
             dismissAllowingStateLoss()
         }

